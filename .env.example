# =============================================================
# Printing IoT System - Environment Variables Template
# =============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# --- Cloudflare Tunnel ---
# Obtain from: https://dash.cloudflare.com -> Zero Trust -> Access -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=FlexoDB

# --- Redis ---
REDIS_CONNECTION_STRING=redis:6379

# --- MQTT Broker ---
MQTT_BROKER_ADDRESS=mqtt-broker
MQTT_BROKER_PORT=1883

# --- JWT ---
# 至少 32 字元;正式環境請改為足夠隨機的字串(例: openssl rand -base64 48)
# 雙底線對應 ASP.NET Core 設定鍵 Jwt:Secret
JWT_SECRET=ChangeMeToAStrongRandomSecretAtLeast32Chars
