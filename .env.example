# =============================================================
# Printing IoT System - Environment Variables Template
# =============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# --- Cloudflare Tunnel ---
# Obtain from: https://dash.cloudflare.com -> Zero Trust -> Access -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=FlexoDB

# --- Redis ---
REDIS_CONNECTION_STRING=redis:6379

# --- MQTT Broker ---
MQTT_BROKER_ADDRESS=mqtt-broker
MQTT_BROKER_PORT=1883

# --- JWT ---
# 至少 32 字元;正式環境請改為足夠隨機的字串(例: openssl rand -base64 48)
# 雙底線對應 ASP.NET Core 設定鍵 Jwt:Secret
JWT_SECRET=ChangeMeToAStrongRandomSecretAtLeast32Chars

# --- 認證初始化 ---
# 一次性初始化權杖,對應設定鍵 Auth:SetupToken。
# 留空 = /api/v1/auth/setup-admin 完全關閉(回 404),這是平常該有的狀態。
# 只有在「建立第一個 ADMIN 帳號」那段時間才填值(例: openssl rand -hex 32),
# 建完立刻清空本行並重啟 API。詳見 docs/report20260906-2.md
AUTH_SETUP_TOKEN=

# 刷新憑證效期(小時),對應設定鍵 Auth:RefreshTokenHours。
# 預設 12,涵蓋一個班;存取權杖本身固定 2 小時,到期由前端自動換發。
AUTH_REFRESH_TOKEN_HOURS=12
